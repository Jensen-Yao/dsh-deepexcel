{
  "$schema": "https://schemas.linxin666.org/dsh-skin/v2.json",
  "skinManifestVersion": 2,
  "id": "deepcel",
  "name": "Deepcel 工作簿",
  "nameEn": "Deepcel Workbook",
  "author": "Small-tailqwq",
  "tagline": "单元格界面 · 合并输入区 · 工作簿功能区",
  "description": "把 DeepSeek Harness WebUI 重解释为一张可工作的电子表格：窗格、消息、工具和设置成为可交互单元格，大输入区成为合并区域，工作簿标签承载多会话导航。v2 重写：声明式 skin.css/patches.css + hooks.mjs 逃生舱，由 skin-center 加载器统一作用域。",
  "tags": [
    "deepcel",
    "spreadsheet",
    "workbook",
    "grid",
    "productivity"
  ],
  "accent": "#217346",
  "order": 6,
  "version": "1.0.0",
  "preview": {
    "light": "preview/light.webp",
    "dark": "preview/dark.webp"
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "x-org.linxin666.skin-center/v1alpha1",
        "kind": "SkinHooks",
        "optional": true
      }
    ]
  },
  "contributes": {
    "stylesheet": "skin.css",
    "patches": "patches.css"
  },
  "facets": {
    "client": {
      "entry": "hooks.mjs",
      "apiVersion": "x-org.linxin666.skin-center/v1alpha1"
    }
  }
}
